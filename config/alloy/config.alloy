// Grafana Alloy on hosts: infrastructure scraping (15 s for prediction-critical
// metrics) and log tailing. Metrics go to VictoriaMetrics AND, via OTLP/JSON,
// to the ingest-gateway so the detectors see them. Do not use Grafana Agent or
// Promtail (end of life).

prometheus.exporter.unix "host" {
  // Only real disks: pseudo, overlay and host-share (bind/virtiofs) mounts look like
  // full or fast-changing disks and would raise false disk_full signals.
  filesystem {
    fs_types_exclude     = "^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|fakeowner|fusectl|fuse\\..*|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|rpc_pipefs|securityfs|selinuxfs|squashfs|sysfs|tracefs|tmpfs|virtiofs)$"
    mount_points_exclude = "^/(dev|proc|run|sys|etc/(alloy|hostname|hosts|resolv\\.conf)|var/lib/docker/.+)($|/)"
  }
}

discovery.relabel "host" {
  targets = prometheus.exporter.unix.host.targets
  rule {
    target_label = "ci_id"
    replacement  = sys.env("CI_ID")
  }
  rule {
    target_label = "tenant_id"
    replacement  = sys.env("TENANT_ID")
  }
}

prometheus.scrape "host" {
  targets         = discovery.relabel.host.output
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.vm.receiver, otelcol.receiver.prometheus.to_ingest.receiver]
}

// Dev only: simulated hosts + platform self-metrics → VictoriaMetrics only
// (chaos-sim already pushes its series to the ingest-gateway itself).
// Simulated hosts (dev `chaos-sim`): relabelled to look like ordinary node_exporter hosts so the
// investigation is not tipped off by the simulator's own labels.
prometheus.scrape "sim" {
  targets         = [{"__address__" = "chaos-sim:8080"}]
  scrape_interval = "15s"
  honor_labels    = true
  forward_to      = [prometheus.relabel.sim.receiver]
}

prometheus.relabel "sim" {
  forward_to = [prometheus.remote_write.vm.receiver]
  rule {
    source_labels = ["ci_id"]
    target_label  = "instance"
  }
  rule {
    target_label = "job"
    replacement  = "node-exporter"
  }
}

prometheus.scrape "platform" {
  targets = [
    {"__address__" = "ingest-gateway:8080", "job" = "aiops", "service" = "ingest-gateway"},
    {"__address__" = "detector-workers:8080", "job" = "aiops", "service" = "detector-workers"},
    {"__address__" = "correlator:8080", "job" = "aiops", "service" = "correlator"},
    {"__address__" = "agent-gateway:8080", "job" = "aiops", "service" = "agent-gateway"},
    {"__address__" = "router:8080", "job" = "aiops", "service" = "router"},
    {"__address__" = "feedback-service:8080", "job" = "aiops", "service" = "feedback-service"},
  ]
  scrape_interval = "15s"
  honor_labels    = true
  forward_to      = [prometheus.remote_write.vm.receiver]
}

prometheus.remote_write "vm" {
  endpoint {
    url = "http://victoriametrics:8428/api/v1/write"
  }
}

otelcol.receiver.prometheus "to_ingest" {
  output {
    metrics = [otelcol.exporter.otlphttp.ingest.input]
  }
}

otelcol.exporter.otlphttp "ingest" {
  client {
    // Via the collector, which re-encodes as OTLP/JSON and adds tenant + auth for the gateway
    // (Alloy's otlphttp exporter has no JSON encoding option).
    endpoint = "http://otel-collector:4318"
  }
}

// System logs → Loki (journald on real hosts; files in the dev container).
local.file_match "syslog" {
  path_targets = [{"__path__" = "/var/log/*.log", "ci_id" = sys.env("CI_ID")}]
}

loki.source.file "syslog" {
  targets    = local.file_match.syslog.targets
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url       = "http://loki:3100/loki/api/v1/push"
    tenant_id = sys.env("TENANT_ID")
  }
}
