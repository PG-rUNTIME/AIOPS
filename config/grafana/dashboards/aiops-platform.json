{
  "uid": "aiops-platform",
  "title": "AIOps / Platform services (RED)",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "aiops"
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "custom",
        "query": "ingest-gateway,detector-workers,correlator,agent-gateway,router,feedback-service",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 99,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "html",
        "content": "<div style=\"display:flex;align-items:center;gap:18px;height:100%\"><img src=\"public/img/cassava/cassava-logo-white.png\" alt=\"Cassava Technologies\" height=\"30\"><div style=\"border-left:1px solid #3a4a72;padding-left:18px\"><div style=\"font:700 18px Montserrat,Arial,sans-serif;color:#fff\">Platform services (RED)</div><div style=\"font:13px Arial,sans-serif;color:#C9D2E3\">Health of the AIOps services themselves (rate, errors, duration)</div></div></div>"
      }
    },
    {
      "id": 1,
      "title": "Messages handled /s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#00F19C"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, outcome) (rate(aiops_messages_total{service=~\"$service\"}[1m]))",
          "legendFormat": "{{service}} {{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Handler p95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#00F19C"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(aiops_handler_duration_seconds_bucket{service=~\"$service\"}[5m])))",
          "legendFormat": "{{service}}",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Signals / candidates per minute",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#00F19C"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5B8DEF"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#C9D2E3"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (detector) (rate(aiops_signals_emitted_total[5m])) * 60",
          "legendFormat": "signals {{detector}}",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (kind) (rate(aiops_candidates_emitted_total[5m])) * 60",
          "legendFormat": "candidates {{kind}}",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        },
        {
          "refId": "C",
          "expr": "sum(rate(aiops_signals_suppressed_total[5m])) * 60",
          "legendFormat": "suppressed",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Verdicts by status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "x": 12,
