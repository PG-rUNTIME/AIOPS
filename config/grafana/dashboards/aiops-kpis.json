{
  "uid": "aiops-kpis",
  "title": "AIOps / Prediction quality (KPIs)",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "aiops"
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Precision by failure type",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aiops_kpi_precision",
          "legendFormat": "{{tenant}} {{failure_type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Recall by failure type",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aiops_kpi_recall",
          "legendFormat": "{{tenant}} {{failure_type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Median lead time (minutes)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aiops_kpi_median_lead_time_minutes",
          "legendFormat": "{{tenant}} {{failure_type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Labelled outcomes",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aiops_kpi_labelled_total",
          "legendFormat": "{{failure_type}} {{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ]
    }
  ]
}
