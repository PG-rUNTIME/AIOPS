{
  "uid": "aiops-kpis",
  "title": "AIOps / Prediction quality (KPIs)",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "aiops"
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 99,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "html",
        "content": "<div style=\"display:flex;align-items:center;gap:18px;height:100%\"><img src=\"public/img/cassava/cassava-logo-white.png\" alt=\"Cassava Technologies\" height=\"30\"><div style=\"border-left:1px solid #3a4a72;padding-left:18px\"><div style=\"font:700 18px Montserrat,Arial,sans-serif;color:#fff\">Prediction quality (KPIs)</div><div style=\"font:13px Arial,sans-serif;color:#C9D2E3\">Were warnings real, were failures caught, and how much notice did teams get</div></div></div>"
      }
    },
    {
      "id": 1,
      "title": "Precision by failure type",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#00F19C"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aiops_kpi_precision",
          "legendFormat": "{{tenant}} {{failure_type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Recall by failure type",
