{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LogBatch": {
        "additionalProperties": false,
        "description": "telemetry.logs payload. Bodies are PII-redacted before they are published.",
        "properties": {
          "ci_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Ci Id",
            "type": "string"
          },
          "records": {
            "items": {
              "$ref": "#/components/schemas/LogRecord"
            },
            "minItems": 1,
            "title": "Records",
            "type": "array"
          },
          "service": {
            "default": "unknown",
            "title": "Service",
            "type": "string"
          },
          "tenant_id": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "tenant_id",
          "ci_id",
          "records"
        ],
        "title": "LogBatch",
        "type": "object"
      },
      "LogRecord": {
        "additionalProperties": false,
        "properties": {
          "attributes": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Attributes",
            "type": "object"
          },
          "body": {
            "maxLength": 16384,
            "title": "Body",
            "type": "string"
          },
          "severity": {
            "default": "INFO",
            "title": "Severity",
            "type": "string"
          },
          "ts": {
            "format": "date-time",
            "title": "Ts",
            "type": "string"
          }
        },
        "required": [
          "ts",
          "body"
        ],
        "title": "LogRecord",
        "type": "object"
      },
      "MetricBatch": {
        "additionalProperties": false,
        "description": "telemetry.metrics payload: points for ONE tenant + CI (one partition key).",
        "properties": {
          "ci_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Ci Id",
            "type": "string"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/MetricPoint"
            },
            "minItems": 1,
            "title": "Points",
            "type": "array"
          },
          "service": {
            "default": "unknown",
            "title": "Service",
            "type": "string"
          },
          "tenant_id": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "tenant_id",
          "ci_id",
          "points"
        ],
        "title": "MetricBatch",
        "type": "object"
      },
      "MetricPoint": {
        "additionalProperties": false,
        "properties": {
          "labels": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Labels",
            "type": "object"
          },
          "name": {
            "description": "Metric name, e.g. node_filesystem_avail_bytes",
            "title": "Name",
            "type": "string"
          },
          "ts": {
            "format": "date-time",
            "title": "Ts",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "number"
          }
        },
        "required": [
          "name",
          "ts",
          "value"
        ],
        "title": "MetricPoint",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "ingest-gateway",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/aiops/logs": {
      "post": {
        "operationId": "native_logs_v1_aiops_logs_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-aiops-tenant",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Aiops-Tenant"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogBatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "integer"
                  },
                  "title": "Response Native Logs V1 Aiops Logs Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Native Logs"
      }
    },
