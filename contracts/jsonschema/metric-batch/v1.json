{
  "$defs": {
    "MetricPoint": {
      "additionalProperties": false,
      "properties": {
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Labels",
          "type": "object"
        },
        "name": {
          "description": "Metric name, e.g. node_filesystem_avail_bytes",
          "title": "Name",
          "type": "string"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "name",
        "ts",
        "value"
      ],
      "title": "MetricPoint",
      "type": "object"
    }
  },
  "$id": "https://schemas.aiops.local/metric-batch/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "telemetry.metrics payload: points for ONE tenant + CI (one partition key).",
  "properties": {
    "ci_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Ci Id",
      "type": "string"
    },
    "points": {
      "items": {
        "$ref": "#/$defs/MetricPoint"
      },
      "minItems": 1,
      "title": "Points",
      "type": "array"
    },
    "service": {
      "default": "unknown",
      "title": "Service",
      "type": "string"
    },
    "tenant_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "ci_id",
    "points"
  ],
  "title": "MetricBatch",
  "type": "object",
  "x-cloudevents-type": "io.aiops.telemetry.metrics.v1",
  "x-topic": "telemetry.metrics"
}
