# Copy to .env (git-ignored) and fill in. Never commit real secrets.
COMPOSE_PROJECT_NAME=aiops

# ---- LLM (one OpenAI-compatible interface). Pick ONE:
# 1) Hosted API (pilot / non-regulated). Example values:
# AIOPS_LLM__BASE_URL=https://api.openai.com/v1
# AIOPS_LLM__MODEL=gpt-4.1
# AIOPS_LLM__API_KEY=sk-...
# 2) Self-hosted vLLM (GPU): make up detects nvidia-smi and starts the `ai-gpu` profile.
# AIOPS_LLM__BASE_URL=http://vllm:8000/v1
# AIOPS_LLM__MODEL=Qwen/Qwen3.8-27B-FP8
# 3) Default (CPU laptop): Ollama in the `ai` profile.
AIOPS_LLM__BASE_URL=http://ollama:11434/v1
AIOPS_LLM__MODEL=qwen3:8b
AIOPS_LLM__API_KEY=
AIOPS_LLM__PROVIDER=openai
VLLM_MODEL=Qwen/Qwen3.8-27B-FP8
HF_TOKEN=

# ---- Infra credentials: required, no defaults. Generate with `openssl rand -base64 32`
POSTGRES_PASSWORD=
MINIO_ROOT_USER=aiops
MINIO_ROOT_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# ---- Tenant / host identity for the collectors
TENANT_ID=
HOST_CI_ID=
ENVIRONMENT=dev

# ---- Ingest auth: per-tenant API keys. Store only the sha256 of each key:
#   INGEST_TENANT_KEYS={"<tenant>":"<sha256 of key>"}   (generate: openssl rand -hex 32)
INGEST_API_KEY=
INGEST_TENANT_KEYS={}

# ---- Delivery channels: referenced from config/router/channels.yaml (see channels.example.yaml)
SMTP_HOST=
SMTP_PORT=25
SMTP_STARTTLS=false
KEEP_API_KEY=
FEEDBACK_WEBHOOK_SECRETS={}
GRAFANA_DEFAULT_TENANT=

# ---- Control plane auth (dev mode: HS256 tokens from `make token`)
# Modes: local (username/password accounts), oidc (SSO via your IdP), dev (pasted HS256 tokens;
# refused when AIOPS_ENVIRONMENT=prod).
AIOPS_AUTH__MODE=local
# local: session tokens are signed with this (>= 32 random chars: `openssl rand -hex 32`).
AIOPS_AUTH__SESSION_SECRET=
# local: creates the first platform admin only while the users table is empty (12+ char password).
AIOPS_BOOTSTRAP_ADMIN_USERNAME=admin
AIOPS_BOOTSTRAP_ADMIN_PASSWORD=
# oidc: AIOPS_AUTH__ISSUER / AIOPS_AUTH__JWKS_URL / AIOPS_AUTH__AUDIENCE; dev: AIOPS_AUTH__DEV_SECRET
AIOPS_AUTH__DEV_SECRET=

# Encrypts data-source credentials at rest. Generate: `python -m control_plane.secretbox`.
# Keep it stable: losing it makes saved credentials unreadable (re-enter them).
AIOPS_SECRETS_KEY=

# Shared secret the agent presents to read data through registered connections (>= 32 chars).
# Set the same value for control-plane-api and agent-gateway: `openssl rand -hex 32`.
AIOPS_INTERNAL_TOKEN=
# Pull host metrics from sources with "feed failure detection" on, into failure detection.
AIOPS_POLLER_ENABLED=true
