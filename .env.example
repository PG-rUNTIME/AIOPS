# Copy to .env (git-ignored) and fill in. Never commit real secrets.
COMPOSE_PROJECT_NAME=aiops

# ---- LLM (one OpenAI-compatible interface). Pick ONE:
# 1) Hosted API (pilot / non-regulated). Example values:
# AIOPS_LLM__BASE_URL=https://api.openai.com/v1
# AIOPS_LLM__MODEL=gpt-4.1
# AIOPS_LLM__API_KEY=sk-...
# 2) Self-hosted vLLM (GPU): make up detects nvidia-smi and starts the `ai-gpu` profile.
# AIOPS_LLM__BASE_URL=http://vllm:8000/v1
# AIOPS_LLM__MODEL=Qwen/Qwen3.8-27B-FP8
# 3) Default (CPU laptop): Ollama in the `ai` profile.
AIOPS_LLM__BASE_URL=http://ollama:11434/v1
AIOPS_LLM__MODEL=qwen3:8b
AIOPS_LLM__API_KEY=
AIOPS_LLM__PROVIDER=openai
VLLM_MODEL=Qwen/Qwen3.8-27B-FP8
HF_TOKEN=

# ---- Infra credentials (dev only)
POSTGRES_PASSWORD=change-me-dev
MINIO_ROOT_USER=aiops
MINIO_ROOT_PASSWORD=change-me-dev-minio
GRAFANA_ADMIN_PASSWORD=change-me-dev

# ---- Ingest auth: the key collectors/chaos-sim present, and its sha256 for the gateway
INGEST_API_KEY=dev-ingest-key
INGEST_TENANT_KEYS={"demo-bank":"21dd9e3b3f1633b88d69b73906f1a9e594beebd9b616bf89448c0a50a8b4ad10"}

# ---- Delivery channels for the demo tenant
SN_DEMO_URL=http://mock-servicenow:8080
SN_DEMO_USER=aiops
SN_DEMO_PASSWORD=dev
CHAT_WEBHOOK_DEMO=http://mock-servicenow:8080/healthz
SMTP_HOST=mailpit
KEEP_API_KEY=
FEEDBACK_WEBHOOK_SECRETS={"demo-bank":"dev-webhook-secret"}

# ---- Control plane auth (dev mode: HS256 tokens from `make token`)
AIOPS_AUTH__MODE=dev
AIOPS_AUTH__DEV_SECRET=dev-only-secret-change-me-0123456789abcdef
