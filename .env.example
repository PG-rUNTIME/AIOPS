# Copy to .env (git-ignored) and fill in. Never commit real secrets.
COMPOSE_PROJECT_NAME=aiops

# ---- LLM (one OpenAI-compatible interface). Pick ONE:
# 1) Hosted API (pilot / non-regulated). Example values:
# AIOPS_LLM__BASE_URL=https://api.openai.com/v1
# AIOPS_LLM__MODEL=gpt-4.1
# AIOPS_LLM__API_KEY=sk-...
# 2) Self-hosted vLLM (GPU): make up detects nvidia-smi and starts the `ai-gpu` profile.
# AIOPS_LLM__BASE_URL=http://vllm:8000/v1
# AIOPS_LLM__MODEL=Qwen/Qwen3.8-27B-FP8
# 3) Default (CPU laptop): Ollama in the `ai` profile.
AIOPS_LLM__BASE_URL=http://ollama:11434/v1
AIOPS_LLM__MODEL=qwen3:8b
AIOPS_LLM__API_KEY=
AIOPS_LLM__PROVIDER=openai
VLLM_MODEL=Qwen/Qwen3.8-27B-FP8
HF_TOKEN=

# ---- Infra credentials: required, no defaults. Generate with `openssl rand -base64 32`
POSTGRES_PASSWORD=
MINIO_ROOT_USER=aiops
MINIO_ROOT_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# ---- Tenant / host identity for the collectors
TENANT_ID=
HOST_CI_ID=
ENVIRONMENT=dev

# ---- Ingest auth: per-tenant API keys. Store only the sha256 of each key:
#   INGEST_TENANT_KEYS={"<tenant>":"<sha256 of key>"}   (generate: openssl rand -hex 32)
INGEST_API_KEY=
INGEST_TENANT_KEYS={}

# ---- Delivery channels: referenced from config/router/channels.yaml (see channels.example.yaml)
SMTP_HOST=
KEEP_API_KEY=
FEEDBACK_WEBHOOK_SECRETS={}
GRAFANA_DEFAULT_TENANT=

# ---- Control plane auth (dev mode: HS256 tokens from `make token`)
# Production: AIOPS_AUTH__MODE=oidc with AIOPS_AUTH__ISSUER / JWKS_URL / AUDIENCE. Dev HS256 tokens
# are refused when AIOPS_ENVIRONMENT=prod. AIOPS_AUTH__DEV_SECRET must be >= 32 random chars.
AIOPS_AUTH__MODE=oidc
AIOPS_AUTH__DEV_SECRET=
